    handleProjectLoaded: function () {
      vm.setCompilerOptions({"enabled":true,"warpTimer":false});
      vm.setFramerate(30);
      const runtimeOptions = {};
      if (true) runtimeOptions.maxClones = Infinity;
      if (true) runtimeOptions.fencing = false;
      if (true) runtimeOptions.miscLimits = false;
      vm.setRuntimeOptions(runtimeOptions);
      if (true) vm.renderer.setUseHighQualityRender(true);
      if (false) vm.setTurboMode(true);
      if (false) vm.setInterpolation(true);
      if (true) { vm.start(); vm.greenFlag(); }
